# Firebase web config — copy this file to `.env` and fill in real values.
# NEVER put the App Check debug token in this file or in the repo.
# How to get these values: create a Firebase project `jobguard-ai`
# (or reuse an existing one), enable AI Logic (Gemini Developer API),
# register a web app, and register a reCAPTCHA Enterprise site key for
# App Check. See ../NOTES.md "Going live" for the exact steps.
# NOTE: a Firebase web apiKey is a public project identifier, not a secret.
# Security comes from App Check + API restrictions in the Firebase console.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: reCAPTCHA Enterprise site key for App Check in production.
# Leave empty for local development (the debug provider is used instead).
VITE_APPCHECK_SITE_KEY=
